# Copy this file to .env and fill in real values.
# Run with: npm start   (or: node --env-file=.env server.mjs — Node 20.6+)

# --- Database (libSQL / Turso) ---
# Local dev: use a SQLite file. No auth token needed.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Production (Vercel): set these in the Vercel dashboard, NOT here.
#   TURSO_DATABASE_URL=libsql://gasuitwarehouse-yourname.turso.io
#   TURSO_AUTH_TOKEN=eyJhbGc... (from Turso dashboard)

# --- Resend transactional email ---
# Sign up at https://resend.com, verify your sending domain.
RESEND_API_KEY=re_replace_me

# Sender + recipient addresses
FROM_EMAIL=bookings@yourdomain.com
OWNER_EMAIL=khatibkareem983@gmail.com

# --- Business identity (used in emails, ICS, confirmation page) ---
BUSINESS_NAME=GA Suit Warehouse
BUSINESS_ADDRESS=150 Pearl Nix Pkwy, Gainesville GA 30501
BUSINESS_PHONE=+14705957775

# --- Public site URL — used in confirmation email links ---
SITE_URL=http://localhost:3000

# --- Local server only ---
PORT=3000

# Set DRY_RUN_EMAIL=true during development to skip Resend and write rendered
# emails to tmp/last-email.html instead. Useful for QA without spamming inboxes.
DRY_RUN_EMAIL=true
