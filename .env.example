# Copy this file to .env and fill in real values.
# Run with: npm start   (or: node --env-file=.env server.mjs — Node 20.6+)

# --- Database (libSQL / Turso) ---
# Local dev: use a SQLite file. No auth token needed.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Production (Vercel): set these in the Vercel dashboard, NOT here.
#   TURSO_DATABASE_URL=libsql://gasuitwarehouse-yourname.turso.io
#   TURSO_AUTH_TOKEN=eyJhbGc... (from Turso dashboard)

# --- Resend transactional email ---
# Sign up at https://resend.com, verify your sending domain.
RESEND_API_KEY=re_replace_me

# Sender + recipient addresses
FROM_EMAIL=bookings@yourdomain.com
OWNER_EMAIL=suitwarehousellc@gmail.com

# --- Business identity (used in emails, ICS, confirmation page) ---
BUSINESS_NAME=GA Suit Warehouse
BUSINESS_ADDRESS=150 Pearl Nix Pkwy, Gainesville GA 30501
BUSINESS_PHONE=+14705957775

# --- Public site URL — used in confirmation email links ---
SITE_URL=http://localhost:3000

# --- Local server only ---
PORT=3000

# Set DRY_RUN_EMAIL=true during development to skip Resend and write rendered
# emails to tmp/last-email.html instead. Useful for QA without spamming inboxes.
DRY_RUN_EMAIL=true

# --- Twilio SMS (pickup-ready notifications) ---
# Sign up at https://twilio.com, complete A2P 10DLC brand + campaign
# registration before sending live US SMS (1–3 week process).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=    # E.164 format, e.g. +14705957775

# Set DRY_RUN_SMS=true during development to skip Twilio and write rendered
# messages to tmp/last-sms.txt instead.
DRY_RUN_SMS=true

# --- Lead magnet ---
# HMAC secret used to sign short lead-token query params (?t=) on prefilled
# booking links. Must be at least 16 chars.
LEAD_TOKEN_SECRET=change-me-to-a-random-string-at-least-16-chars

# Bearer token required by /api/cron/* endpoints (Vercel Cron Jobs include it
# automatically when configured in vercel.json; for manual local runs pass
# `-H "Authorization: Bearer $CRON_SECRET"`). Must be at least 16 chars.
CRON_SECRET=change-me-to-another-random-string-at-least-16-chars

# Bearer token required by /api/admin/* endpoints (staff redeem tool +
# funnel-stats dashboard). Stored in localStorage on the iPad; rotate this
# value any time to invalidate all stored tokens. Must be at least 16 chars.
STAFF_TOKEN=change-me-to-another-random-string-at-least-16-chars
