# Copy this file to .env and fill in real values.
# Run with: node --env-file=.env server.mjs   (Node 20.6+)

# Resend transactional email — sign up at https://resend.com, verify your sending domain
RESEND_API_KEY=re_replace_me

# Sender + recipient addresses
FROM_EMAIL=bookings@yourdomain.com
OWNER_EMAIL=khatibkareem983@gmail.com

# Business identity (used in emails, ICS, confirmation page)
BUSINESS_NAME=GA Suit Warehouse
BUSINESS_ADDRESS=150 Pearl Nix Pkwy, Gainesville GA 30501
BUSINESS_PHONE=+14705957775

# Public site URL — used to build links in confirmation emails
SITE_URL=http://localhost:3000

# Server
PORT=3000

# Set DRY_RUN_EMAIL=true during development to skip Resend and write rendered emails
# to tmp/last-email.html instead. Useful for QA without spamming inboxes.
DRY_RUN_EMAIL=true
