# Copy this file to .env and fill in real values.
# Run with: npm start   (or: node --env-file=.env server.mjs — Node 20.6+)

# --- Database (libSQL / Turso) ---
# Local dev: use a SQLite file. No auth token needed.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Production (Vercel): set these in the Vercel dashboard, NOT here.
#   TURSO_DATABASE_URL=libsql://gasuitwarehouse-yourname.turso.io
#   TURSO_AUTH_TOKEN=eyJhbGc... (from Turso dashboard)

# --- Resend transactional email ---
# Sign up at https://resend.com, verify your sending domain.
RESEND_API_KEY=re_replace_me

# Sender + recipient addresses
FROM_EMAIL=bookings@yourdomain.com
OWNER_EMAIL=suitwarehousellc@gmail.com

# Store owner's mobile — receives an SMS alert on every new booking.
OWNER_PHONE=+17704468888

# --- Business identity (used in emails, ICS, confirmation page) ---
BUSINESS_NAME=GA Suit Warehouse
BUSINESS_ADDRESS=150 Pearl Nix Pkwy, Gainesville GA 30501
BUSINESS_PHONE=+14705957775

# --- Public site URL — used in confirmation email links ---
SITE_URL=http://localhost:3000

# --- Local server only ---
PORT=3000

# Set DRY_RUN_EMAIL=true during development to skip Resend and write rendered
# emails to tmp/last-email.html instead. Useful for QA without spamming inboxes.
DRY_RUN_EMAIL=true

# --- Twilio SMS (pickup-ready notifications) ---
# Sign up at https://twilio.com, complete A2P 10DLC brand + campaign
# registration before sending live US SMS (1–3 week process).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=    # E.164 format, e.g. +14705957775

# Set DRY_RUN_SMS=true during development to skip Twilio and write rendered
# messages to tmp/last-sms.txt instead.
DRY_RUN_SMS=true

# --- Lead magnet ---
# HMAC secret used to sign short lead-token query params (?t=) on prefilled
# booking links. Must be at least 16 chars.
LEAD_TOKEN_SECRET=change-me-to-a-random-string-at-least-16-chars

# Bearer token required by /api/cron/* endpoints (Vercel Cron Jobs include it
# automatically when configured in vercel.json; for manual local runs pass
# `-H "Authorization: Bearer $CRON_SECRET"`). Must be at least 16 chars.
CRON_SECRET=change-me-to-another-random-string-at-least-16-chars

# --- Staff dashboard login ---
# Short shared password staff type once per device at /staff/intakes (or
# /staff/stats, /staff/redeem). A successful login sets a signed, HttpOnly
# cookie good for 30 days; every /api/admin/* endpoint 401s without it.
# Must be at least 6 chars. REQUIRED in Vercel env — if unset, nobody can log
# in and the dashboards stay locked.
STAFF_PASSWORD=change-me

# Bearer token accepted by EVERY /api/admin/* endpoint as an alternative to the
# password cookie — break-glass for scripts and for getting in if
# STAFF_PASSWORD is ever missing. Also the default key used to sign login
# cookies, so rotating it signs every device out. Must be at least 16 chars.
STAFF_TOKEN=change-me-to-another-random-string-at-least-16-chars

# Optional: dedicated signing key for the login cookie. When set it is used
# instead of STAFF_TOKEN, so you can sign devices out without rotating the
# break-glass token. Must be at least 16 chars.
STAFF_SESSION_SECRET=

# --- Google Ads offline conversion feed ---
# HTTP Basic credentials for the scheduled-upload feed Google Ads fetches daily
# at /feeds/ads-conversions.csv. Both must be at least 16 chars; the feed
# returns 401 until both are set.
ADS_FEED_USER=change-me-random-user-at-least-16-chars
ADS_FEED_PASS=change-me-random-pass-at-least-16-chars

# --- Google Places (live homepage rating chip) ---
# Place ID for GA Suit Warehouse from https://developers.google.com/maps/documentation/places/web-service/place-id
# Maps Platform API key with Places API (New) enabled and HTTP-referrer
# restricted to https://www.gasuitwarehouse.com/*
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
